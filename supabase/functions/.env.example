# Copy outside source control and inject with Supabase secrets. Never paste real keys into chat.
JOB_SECRET=

# AI has no backend credentials or proxy. Users configure their device in App settings.
# Confirmed originals remain in private Storage; Image Transform is never used.

# Apple .p8 content; use escaped newlines for a single-line secret.
APNS_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# TestFlight uses production. Xcode development builds use sandbox.
APNS_ENVIRONMENT=production

JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# Optional verified app-link host; no protocol prefix.
APP_LINK_HOST=
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase.
